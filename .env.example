# Domen na kome radi sajt i panel (DNS A zapis mora pokazivati na server)
DOMAIN=tvojdomen.com
PUBLIC_URL=https://tvojdomen.com
APP_NAME=Orbit Player

# Napravi svaku vrednost komandom: openssl rand -hex 32
ENCRYPTION_KEY=
APP_SECRET=
POSTGRES_PASSWORD=

# Prvi admin nalog — pravi se samo ako nema nijednog admina. Posle prve prijave obriši ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

LOG_LEVEL=info
